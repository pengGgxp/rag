FROM python:3.12-slim
WORKDIR /app
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=3 update \
    && apt-get -o Acquire::Retries=3 install -y --no-install-recommends libreoffice-writer fonts-noto-cjk libseccomp2 \
    && rm -rf /var/lib/apt/lists/*
# Office must keep its IPC socket inside the job directory selected by OSL_SOCKET_PATH.
RUN chmod 0755 /tmp /var/tmp
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app ./app
CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--queues=previews", "--concurrency=1", "--max-tasks-per-child=20"]
