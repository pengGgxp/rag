DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0
# Legacy original-file source for the one-time COS migration only.
# Configure Tencent COS credentials in /admin/storage, not in this file.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag-documents
S3_REGION=us-east-1
NEXT_PUBLIC_API_URL=http://localhost:8000
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30
# Chat model connections are managed in the site console, not environment variables.
# Persistent Fernet key for encrypted MCP authentication headers. Back up separately.
MCP_CREDENTIAL_KEY=
# Comma-separated exact trusted hosts; only administrators configure private-network access.
MCP_ALLOWED_PRIVATE_HOSTS=
MCP_TIMEOUT_SECONDS=60
# local: text-layer PDF parsing; aliyun: send new PDFs to Alibaba Cloud DocMind.
# No VLM enhancement. Cloud submission budgets are batched, not per-file limits.
PDF_PARSER=local
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
DOCMIND_TIMEOUT_SECONDS=300
DOCMIND_POLL_SECONDS=3
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
# Set true when serving over HTTPS. False is for local HTTP Docker only.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
# Random secret of at least 32 characters, required when enabling OIDC.
AUTH_SECRET_KEY=
# Independent Fernet key for site SMTP, Senyu and COS credentials. Back up separately.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Configure SMTP and WeChat in /admin/auth after granting a site administrator from the server CLI.
SITE_CONFIG_ENCRYPTION_KEY=
OIDC_NAME=
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Legacy Payment FM bootstrap values. The admin page imports these as a draft
# until the first save to the database; after that, database settings control new orders.
# Configure SITE_CONFIG_ENCRYPTION_KEY on the API before saving merchant credentials.
ZHIFUX_ENABLED=false
ZHIFUX_API_BASE_URL=
ZHIFUX_MERCHANT_NUM=
ZHIFUX_SECRET=
ZHIFUX_PAY_TYPE=
# Initial draft only: JSON array of {id, name, amount_fen, credits}.
RECHARGE_PACKAGES_JSON=[]
USAGE_AUTHORIZATION_HOLD_CREDITS=1

