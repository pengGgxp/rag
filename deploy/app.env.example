# Authoritative server-side application configuration.
# The real file is /opt/zhiku/config/app.env with mode 600.
# Runtime settings, plus release metadata checked by the deployer.
# Empty values are allowed only where the capability is intentionally disabled.

# Required core
DATABASE_URL=postgresql+psycopg://rag:change-me@db:5432/rag
REDIS_URL=redis://redis:6379/0
AUTH_SECRET_KEY=
SITE_CONFIG_ENCRYPTION_KEY=
MCP_CREDENTIAL_KEY=
FRONTEND_URL=https://zk.str1ct.top
API_PUBLIC_URL=https://zk.str1ct.top/api
AUTH_COOKIE_SECURE=true

# Build/release consistency only; changing it does not rebuild the Web image.
NEXT_PUBLIC_API_URL=https://zk.str1ct.top/api

# Session, preview and release control
AUTH_SESSION_HOURS=168
PREVIEW_ENABLED=true
PREVIEW_DOMAIN=preview.str1ct.top
PREVIEW_CACHE_MAX_BYTES=5368709120
PREVIEW_CACHE_IDLE_SECONDS=604800
DEPLOY_CONTROL_TOKEN=

# RAG embedding
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=30

# Legacy single LLM fallback; normal chat models are managed in site admin
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# Document parsing
PDF_PARSER=local
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
DOCMIND_TIMEOUT_SECONDS=300
DOCMIND_POLL_SECONDS=3

# MCP
MCP_ALLOWED_PRIVATE_HOSTS=
MCP_TIMEOUT_SECONDS=60

# OIDC remains environment-configured. Saved admin SMTP settings take precedence.
OIDC_NAME=企业账号
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Legacy payment bootstrap. Admin payment settings take precedence after save.
ZHIFUX_ENABLED=false
ZHIFUX_API_BASE_URL=
ZHIFUX_MERCHANT_NUM=
ZHIFUX_SECRET=
ZHIFUX_PAY_TYPE=
ZHIFUX_PAYMENT_METHODS_JSON=
ZHIFUX_CUSTOM_RECHARGE_ENABLED=false
ZHIFUX_CUSTOM_CREDITS_PER_YUAN=100
RECHARGE_PACKAGES_JSON=[]
EZFP_ENABLED=false
EZFP_API_BASE_URL=https://www.ezfp.cn/api/pay/create
EZFP_PID=
EZFP_PAY_TYPE=wxpay
EZFP_PAYMENT_METHODS_JSON=
EZFP_PRIVATE_KEY=
EZFP_PUBLIC_KEY=
EZFP_RECHARGE_PACKAGES_JSON=[]
EZFP_CUSTOM_RECHARGE_ENABLED=false
EZFP_CUSTOM_CREDITS_PER_YUAN=100
# Exact proxy peers/CIDRs for payment XFF resolution; empty trusts no proxy.
# Managed Nginx/Docker releases require one checked bridge gateway host address.
# Empty/stale/broad trust blocks deploy and rollback; see docs/payment-client-ip.md.
PAYMENT_TRUSTED_PROXY_IPS=
USAGE_AUTHORIZATION_HOLD_CREDITS=1

# Resource cache. This is application cache, not cloud-computer storage.
RESOURCE_CACHE_DIR=/var/cache/rag-resources
RESOURCE_CACHE_MAX_BYTES=5368709120
RESOURCE_CACHE_IDLE_SECONDS=86400

# Legacy fields retained in Settings; not controls for cloud computers.
WORKSPACE_EXECUTOR_URL=
WORKSPACE_RUNNER_IMAGE=rag-workspace-executor:latest
WORKSPACE_FILE_RETENTION_DAYS=3
WORKSPACE_FILE_QUOTA_MB=500

# Question workbench bridge. Secret stays in .env.question-workbench.
QUESTION_WORKBENCH_URL=https://q.str1ct.top
QUESTION_WORKBENCH_API_URL=http://question-workbench-api:8100

# Existing RustFS credentials must be preserved; do not use these for OSS.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rag-documents
S3_REGION=us-east-1

# Release identity. Normally injected by deploy_release.py from release.json.
APP_VERSION=dev
GIT_COMMIT=unknown
CONFIG_CONTRACT=1
DEPLOYMENT_ROLLBACK=automatic-app-rollback
